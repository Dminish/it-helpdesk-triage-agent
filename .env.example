OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=it-helpdesk-manuals

# "ollama" (default, local) or "openai" (hosted, used for the deployed demo)
LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5
# OPENAI_MODEL=gpt-4o-mini

# Point the chat model at any OpenAI-compatible endpoint (OpenRouter, Groq,
# Together, DeepSeek, local vLLM). Leave both blank to use OpenAI directly.
# Embeddings always use OPENAI_API_KEY above, so set LLM_API_KEY rather than
# overwriting it -- otherwise retrieval breaks while the chat model still works.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=z-ai/glm-4.6
# LLM_API_KEY=
