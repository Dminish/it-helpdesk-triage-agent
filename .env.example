OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=it-helpdesk-manuals

# "ollama" (default, local) or "openai" (hosted, used for the deployed demo)
LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5
# OPENAI_MODEL=gpt-4o-mini

# Point the chat model at any OpenAI-compatible endpoint (OpenRouter, Groq,
# Together, DeepSeek, local vLLM). Leave both blank to use OpenAI directly.
# Embeddings always use OPENAI_API_KEY above, so set LLM_API_KEY rather than
# overwriting it -- otherwise retrieval breaks while the chat model still works.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=z-ai/glm-4.6
# LLM_API_KEY=

# Emails the requester when a ticket is escalated. With SMTP_HOST unset the app
# still works and reports the notification as not sent, rather than failing.
# For Gmail, SMTP_PASSWORD must be an app password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=DanTech Helpdesk <you@gmail.com>
